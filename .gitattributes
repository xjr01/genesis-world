# Force LF line endings for shell scripts
*.sh text eol=lf

# Force LF line endings for configuration files
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.conf text eol=lf

# Force LF for Docker-related files
Dockerfile text eol=lf
*.dockerignore text eol=lf

# Preserve imported garment geometry bytes and their source hashes.
examples/garment_folding/assets/**/*.obj -text -whitespace
examples/garment_folding/assets/**/*.urdf -text -whitespace
